# ---- Backend ----
# SQLite works out of the box. For Postgres + pgvector (needed from Day 3):
#   DATABASE_URL=postgresql+psycopg://gitcontext:gitcontext@localhost:5432/gitcontext
DATABASE_URL=sqlite:///./gitcontext.db
# Where cloned repositories are stored (Day 2)
WORKSPACE_DIR=./workspace
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---- AI providers (needed from Day 3 / Day 5; NOT used on Day 1) ----
# Add YOUR_KEY here. Never commit this file.
LLM_API_KEY=
EMBEDDING_API_KEY=
# Optional: raises GitHub rate limits / private repos (Day 2)
GITHUB_TOKEN=

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Embeddings (Day 3) ----
# hashing = local deterministic baseline (no key). openai = any OpenAI-compatible /embeddings API.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---- Auth / SaaS core ----
SESSION_DAYS=7
# Set to true when served over HTTPS (production). Cookies are HttpOnly + SameSite=Lax always.
COOKIE_SECURE=false
MAX_REPOS_PER_WORKSPACE=5
# Frontend server only (never exposed to the browser): where /api/* is proxied
# BACKEND_URL=http://localhost:8000
